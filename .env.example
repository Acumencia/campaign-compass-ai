# Tracked template: placeholders only.
# Local plaintext configuration. Never commit or share real keys.
# Generation choice: blank, openai, or anthropic. No default provider.
CAMPAIGN_GENERATION_PROVIDER=
# Embeddings are independent: blank or openai. Claude has no embedding model.
CAMPAIGN_EMBEDDING_PROVIDER=
# OpenAI API: fixed https://api.openai.com; no custom endpoints.
CAMPAIGN_OPENAI_ENABLED=0
CAMPAIGN_OPENAI_API_KEY=
CAMPAIGN_OPENAI_GENERATION_MODEL=
CAMPAIGN_OPENAI_MAX_OUTPUT_TOKENS=2048
CAMPAIGN_OPENAI_EMBEDDING_MODEL=
CAMPAIGN_OPENAI_EMBEDDING_DIMENSIONS=
# Anthropic API: fixed https://api.anthropic.com; no custom endpoints.
CAMPAIGN_ANTHROPIC_ENABLED=0
CAMPAIGN_ANTHROPIC_API_KEY=
CAMPAIGN_ANTHROPIC_GENERATION_MODEL=
CAMPAIGN_ANTHROPIC_MAX_OUTPUT_TOKENS=2048
